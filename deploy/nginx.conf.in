# Install inside /etc/nginx/sites-enabled (included by the http block).
limit_req_zone $binary_remote_addr zone=cppai_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=cppai_connections:10m;
limit_conn_zone $server_name zone=cppai_site_connections:1m;

server {
    listen 80;
    server_name @DOMAIN@;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://@DOMAIN@$request_uri; }
}

server {
    listen 443 ssl;
    server_name @DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 64k;
    client_header_timeout 10s;
    client_body_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    limit_req zone=cppai_requests burst=20 nodelay;
    limit_req_status 429;
    limit_conn cppai_connections 20;
    limit_conn cppai_site_connections 128;
    location = /healthz { return 404; }
    location ~ (^|/)\. { return 404; }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host @DOMAIN@;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 200s;
        proxy_send_timeout 30s;
        # Never retry a paid generation request on another upstream.
        proxy_next_upstream off;
    }
}
