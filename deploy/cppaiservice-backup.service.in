[Unit]
Description=Daily private MySQL backup for CppAIService
After=mysql.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT@
StateDirectory=cppaiservice
StateDirectoryMode=0700
Environment=CHAT_BACKUP_DIR=/var/lib/cppaiservice/backups
ExecStart=/usr/bin/python3 @PROJECT@/scripts/backup_database.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
TimeoutStartSec=15min
