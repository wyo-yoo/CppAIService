# Copy to .env for an existing database, or run python3 scripts/setup_database.py.
CHAT_MYSQL_URL=tcp://127.0.0.1:3306
CHAT_MYSQL_USER=cppaiservice
CHAT_MYSQL_PASSWORD=
CHAT_MYSQL_DATABASE=ChatHttpServer

# Fill only the providers you use. Actual credentials belong in .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DOUBAO_API_KEY=
Knowledge_Base_ID=
BAIDU_CLIENT_ID=
BAIDU_CLIENT_SECRET=

# Local development listens only on this machine. Use SSH forwarding from Windows.
CHAT_BIND_ADDRESS=127.0.0.1
# Set these together for a same-host HTTPS reverse proxy; see docs/PUBLIC_DEPLOYMENT.md.
CHAT_PUBLIC_ORIGIN=
CHAT_TRUST_PROXY=0
CHAT_REGISTRATION_OPEN=1
# Explicitly enable only providers that have been configured. 5 = DeepSeek.
CHAT_ALLOWED_MODELS=5
CHAT_ENABLE_TTS=0

# All generation endpoints share these limits. Daily reset is at 00:00 UTC.
CHAT_USER_DAILY_LIMIT=20
CHAT_SITE_DAILY_LIMIT=200
CHAT_USER_PER_MINUTE=6
CHAT_MAX_CONCURRENT=4
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_REGISTRATIONS_DAILY=50
CHAT_REGISTRATIONS_IP_DAILY=5
CHAT_BACKUP_RETENTION_DAYS=14
